# PostHog event collection (safe to expose to the browser)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog dashboard queries (server only)
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=https://us.posthog.com

# Use a long, unique password. This value also signs the access cookie.
ANALYTICS_PASSWORD=
